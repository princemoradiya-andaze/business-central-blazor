@page "/account/company"
@model BusinessCentralBlazor.Web.Pages.Account.CompanyModel
@{
    Layout = null;
    ViewData["Title"] = "Select company";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Business Central Blazor</title>
    <link rel="stylesheet" href="~/signin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/global-workspace.css" asp-append-version="true" />
</head>
<body>
    <main class="signin-page">
        <section class="signin-card" aria-labelledby="page-title">
            <a class="signin-brand" href="/" aria-label="Business Central Blazor home">
                <span aria-hidden="true">BC</span>Business Central Blazor
            </a>
            <div class="account-card-content">
                <h1 id="page-title">Select a company</h1>
                <p class="account-description">Choose the company workspace you want to continue to.</p>

                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="signin-error" role="alert">@Model.StatusMessage</div>
                }

                @if (Model.AvailableCompanies.Count == 0)
                {
                    <div class="account-empty-state" role="status">
                        <h2>No company access yet</h2>
                        <p>No active company memberships are assigned to your account. Contact an administrator for access.</p>
                    </div>
                }
                else
                {
                    @if (Model.ActiveCompany is not null)
                    {
                        <p class="account-current-company">
                            Current selection: <strong>@Model.ActiveCompany.Name (@Model.ActiveCompany.Code)</strong>
                        </p>
                    }
                    else
                    {
                        <p class="account-description">Your account can access multiple companies. Select one to continue.</p>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="signin-error" role="alert"></div>
                        <h2 class="signin-section-heading">Available Companies</h2>
                        <label for="company-search" class="sr-only">Search companies</label>
                        <input id="company-search" type="search" class="signin-input" placeholder="Search companies" />
                        <div id="company-choices" class="signin-company-list">
                            @foreach (var company in Model.AvailableCompanies)
                            {
                                <button type="submit" name="SelectedCompanyId" value="@company.CompanyId"
                                        class="signin-company-choice"
                                        aria-current="@(company.CompanyId == Model.ActiveCompany?.CompanyId ? "true" : null)">
                                    @company.Name (@company.Code)
                                    @if (company.CompanyId == Model.ActiveCompany?.CompanyId) { <span> — Current company</span> }
                                </button>
                            }
                        </div>
                        <p id="no-company-matches" role="status" hidden>No companies match your search.</p>
                    </form>
                }
                <div class="signin-actions">
                    <form method="post" action="/account/logout">
                        @Html.AntiForgeryToken()
                        <button class="signin-link" type="submit">Sign out</button>
                    </form>
                </div>
            </div>
        </section>
        <p class="signin-footer">Secure access to your company workspace</p>
    </main>
<script src="~/js/companySearch.js" asp-append-version="true"></script>
<div class="app-loading" id="account-loader" role="status" hidden><span class="app-loading-spinner" aria-hidden="true"></span><span>Getting ready...</span></div>
<script src="~/js/accountLoading.js" asp-append-version="true"></script>
</body>
</html>
