@page "/account/access-denied"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    Layout = null;
    ViewData["Title"] = "Access denied";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Business Central Blazor</title>
</head>
<body>
    <main>
        <h1>Access denied</h1>
        <p>Your account is not authorized to access this resource.</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <p><a href="/account/company">Select an available company</a></p>
        }
        else
        {
            <p><a href="/account/login">Sign in</a></p>
        }
    </main>
</body>
</html>
