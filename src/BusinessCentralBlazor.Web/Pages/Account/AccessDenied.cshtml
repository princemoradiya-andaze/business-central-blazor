@page "/account/access-denied"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    Layout = null;
    ViewData["Title"] = "Access denied";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Business Central Blazor</title>
    <link rel="stylesheet" href="~/signin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/global-workspace.css" asp-append-version="true" />
</head>
<body>
    <main class="signin-page">
        <section class="signin-card" aria-labelledby="page-title">
            <a class="signin-brand" href="/" aria-label="Business Central Blazor home">
                <span aria-hidden="true">BC</span>Business Central Blazor
            </a>
            <div class="account-card-content">
                <h1 id="page-title">Access unavailable</h1>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <p class="account-description">Your account is signed in, but it does not currently have an active company selection for this page.</p>
                    <a class="signin-primary signin-primary-link" href="/account/company">View available companies</a>
                    <p class="signin-help">If no companies are listed, contact your system administrator to request access.</p>
                    <div class="signin-actions">
                        <form method="post" action="/account/logout">
                            @Html.AntiForgeryToken()
                            <button class="signin-link" type="submit">Sign out</button>
                        </form>
                    </div>
                }
                else
                {
                    <p class="account-description">Sign in with an account provided by your administrator to continue.</p>
                    <div class="signin-actions"><a class="signin-primary signin-primary-link" href="/account/login">Go to sign in</a></div>
                }
            </div>
        </section>
        <p class="signin-footer">Secure access to your company workspace</p>
    </main>
    <div class="app-loading" id="account-loader" role="status" hidden><span class="app-loading-spinner" aria-hidden="true"></span><span>Getting ready...</span></div>
    <script src="~/js/accountLoading.js" asp-append-version="true"></script>
</body>
</html>
