@implements IDisposable
@inject NavigationManager Navigation

@if (!IsCustomerListPage &&
     !CurrentPath.Equals("/financial/sales/customers/new", StringComparison.OrdinalIgnoreCase) &&
     !IsVendorsPage &&
     !IsRecordWorkspacePage &&
     CurrentPage is { } currentPage)
{
    <section class="page-command-bar" aria-label="@($"{currentPage.Title} commands")">
        <div class="page-heading">
            <div class="breadcrumb">Home <span aria-hidden="true">›</span> @currentPage.Area</div>
            <h1>@currentPage.Title</h1>
        </div>
        <nav class="command-actions" aria-label="Page actions">
            @foreach (var action in currentPage.Actions)
            {
                <a href="@action.Href">@action.Label</a>
            }
        </nav>
    </section>
}

@code {
    private static readonly PageDefinition[] Pages =
    [
        new("/financial/sales", "Sales", "Customers",
        [
            new("New customer", "/financial/sales/customers/new")
        ]),
        new("/financial/sales/customers", "Sales", "Customers",
        [
            new("New customer", "/financial/sales/customers/new")
        ]),
        new("/financial/sales/customers/new", "Sales", "New customer",
        [
            new("Customers", "/financial/sales/customers")
        ]),
        new("/financial/sales/create-order", "Sales", "Create sales order", []),
        new("/financial/sales/orders", "Sales", "Sales orders",
        [
            new("Create sales order", "/financial/sales/create-order")
        ]),
        new("/financial/sales/fulfillment", "Sales", "Ship and invoice orders", []),
        new("/financial/sales/receivables", "Sales", "Open receivables", []),
        new("/financial/purchasing", "Purchasing", "Vendors and purchase orders",
        [
            new("New vendor", "/financial/purchasing/vendors/new"),
            new("New purchase order", "#purchase-order-heading"),
            new("Receive and invoice", "#receipt-invoice-heading")
        ]),
        new("/financial/journals", "Finance", "General journals",
        [
            new("New journal batch", "/financial/journals/new")
        ]),
        new("/financial/dimensions", "Finance", "Dimensions",
        [
            new("New dimension", "/financial/dimensions/new")
        ]),
        new("/financial/accounting-periods", "Finance", "Accounting periods",
        [
            new("New period", "#new-period-heading")
        ])
    ];

    private PageDefinition? CurrentPage => Pages.FirstOrDefault(page =>
        string.Equals(CurrentPath, page.Path, StringComparison.OrdinalIgnoreCase));

    private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
    private bool IsCustomerListPage =>
        CurrentPath.Equals("/financial/sales", StringComparison.OrdinalIgnoreCase) ||
        CurrentPath.Equals("/financial/sales/customers", StringComparison.OrdinalIgnoreCase);
    private bool IsVendorsPage =>
        CurrentPath.Equals("/financial/purchasing/vendors", StringComparison.OrdinalIgnoreCase);
    private bool IsRecordWorkspacePage =>
        CurrentPath.Equals("/financial/inventory", StringComparison.OrdinalIgnoreCase) ||
        CurrentPath.Equals("/financial/banks", StringComparison.OrdinalIgnoreCase) ||
        CurrentPath.Equals("/financial/general-ledger/accounts", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private sealed record PageDefinition(string Path, string Area, string Title, CommandAction[] Actions);
    private sealed record CommandAction(string Label, string Href);
}
