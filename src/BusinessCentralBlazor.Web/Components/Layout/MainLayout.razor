@inherits LayoutComponentBase

<div class="app-shell">
    <header class="global-header">
        <a class="app-brand" href="/" aria-label="Business Central Blazor home">
            <span class="app-launcher" aria-hidden="true">▦</span>
            <span class="brand-name">Business Central Blazor</span>
        </a>
        <div class="global-actions">
            <span class="environment-label">Environment <strong>Local</strong></span>
            <AuthorizeView>
                <Authorized>
                    <a href="/financial/company-settings">Company workspace settings</a>
                    <form method="post" action="/account/logout">
                        <AntiforgeryToken />
                        <button type="submit">Sign out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <NavMenu />

    <main class="workspace-main">
        <div class="workspace-content">
            <PageCommandBar />
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
