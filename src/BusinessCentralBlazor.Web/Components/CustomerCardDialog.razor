@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog class="customer-card-dialog" aria-labelledby="@LabelledBy" aria-describedby="@DescribedBy" @ref="dialog">
    @ChildContent
</dialog>

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string LabelledBy { get; set; } = "new-customer-heading";
    [Parameter] public string? DescribedBy { get; set; }
    [Parameter] public string ReturnFocusSelector { get; set; } = ".customer-actions a[href='/financial/sales/customers/new']";
    [Parameter] public string? ReturnFocusFallbackSelector { get; set; }
    private ElementReference dialog;
    private IJSObjectReference? module;
    private DotNetObjectReference<CustomerCardDialog>? reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/customerCardDialog.js");
            reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("open", dialog, reference);
        }
    }

    [JSInvokable]
    public async Task RequestClose()
    {
        if (!IsSaving)
        {
            await OnClose.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("cleanup", dialog, ReturnFocusSelector, ReturnFocusFallbackSelector);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already disconnected.
            }
        }
        reference?.Dispose();
    }
}
