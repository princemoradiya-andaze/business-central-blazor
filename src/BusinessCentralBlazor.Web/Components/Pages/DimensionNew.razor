@page "/financial/dimensions/new"
@attribute [Authorize(Policy = CompanyAuthorizationPolicies.ActiveCompany)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDimensionService DimensionService
@inject NavigationManager Navigation

<PageTitle>New dimension</PageTitle>
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/financial/dimensions">Dimensions</a></li>
        <li class="breadcrumb-item active" aria-current="page">New dimension</li>
    </ol>
</nav>
<h1>New dimension</h1>
<p class="text-body-secondary">Create a dimension for the active company.</p>

<DimensionForm Model="@input" SubmitText="Create dimension" IsSaving="@isSaving"
               ErrorMessage="@errorMessage" OnValidSubmit="CreateAsync" />

@if (companyContextUnavailable)
{
    <p class="mt-3"><a href="/account/company" data-enhance-nav="false">Select an active company</a></p>
}

@code {
    private readonly DimensionInput input = new();
    private bool isSaving;
    private bool companyContextUnavailable;
    private string? errorMessage;

    private async Task CreateAsync()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var dimensionId = await DimensionService.CreateAsync(user, input);
            Navigation.NavigateTo($"/financial/dimensions/{dimensionId}");
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
