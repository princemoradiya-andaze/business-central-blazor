@page "/financial/dimensions/{DimensionId:guid}/edit"
@attribute [Authorize(Policy = CompanyAuthorizationPolicies.ActiveCompany)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDimensionService DimensionService
@inject NavigationManager Navigation

<PageTitle>Edit dimension</PageTitle>
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/financial/dimensions">Dimensions</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit dimension</li>
    </ol>
</nav>

@if (isLoading)
{
    <p role="status" aria-live="polite">Loading dimension...</p>
}
else if (companyContextUnavailable)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
    <a href="/account/company" data-enhance-nav="false">Select an active company</a>
}
else if (notFound)
{
    <h1>Dimension not found</h1>
    <p>This dimension does not exist in the active company.</p>
    <a href="/financial/dimensions">Back to dimensions</a>
}
else
{
    <h1>Edit dimension</h1>
    <DimensionForm Model="@input" SubmitText="Save changes" IsSaving="@isSaving"
                   ErrorMessage="@errorMessage" OnValidSubmit="SaveAsync" />
}

@code {
    [Parameter]
    public Guid DimensionId { get; set; }

    private readonly DimensionInput input = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool notFound;
    private bool companyContextUnavailable;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var dimension = await DimensionService.GetAsync(user, DimensionId);
            if (dimension is null)
            {
                notFound = true;
                return;
            }

            input.Code = dimension.Code;
            input.Name = dimension.Name;
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await DimensionService.UpdateAsync(user, DimensionId, input))
            {
                notFound = true;
                return;
            }

            Navigation.NavigateTo($"/financial/dimensions/{DimensionId}");
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
