@page "/financial/general-ledger/accounts/new"
@attribute [Authorize(Policy = CompanyAuthorizationPolicies.ActiveCompany)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGeneralLedgerAccountService AccountService
@inject NavigationManager Navigation

<PageTitle>New account</PageTitle>

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/financial/general-ledger/accounts">Chart of Accounts</a></li>
        <li class="breadcrumb-item active" aria-current="page">New account</li>
    </ol>
</nav>

<h1>New account</h1>
<p class="text-body-secondary">Create an account in the active company.</p>

<GeneralLedgerAccountForm Model="@input"
                          ParentAccounts="@parentAccounts"
                          SubmitText="Create account"
                          IsSaving="@isSaving"
                          ErrorMessage="@errorMessage"
                          OnValidSubmit="CreateAsync" />

@if (companyContextUnavailable)
{
    <p class="mt-3"><a href="/account/company" data-enhance-nav="false">Select an active company</a></p>
}

@code {
    private readonly GeneralLedgerAccountInput input = new();
    private IReadOnlyList<GeneralLedgerAccountListItem> parentAccounts = [];
    private bool isSaving;
    private bool companyContextUnavailable;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            parentAccounts = await AccountService.GetAllAsync(user);
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
    }

    private async Task CreateAsync()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var accountId = await AccountService.CreateAsync(user, input);
            Navigation.NavigateTo($"/financial/general-ledger/accounts/{accountId}/edit");
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
