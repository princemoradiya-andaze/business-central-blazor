@page "/financial/journals/{BatchId:guid}"
@attribute [Authorize(Policy = CompanyAuthorizationPolicies.ActiveCompany)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGeneralJournalService GeneralJournalService
@inject NavigationManager Navigation

<PageTitle>Journal batch</PageTitle>

@if (isLoading)
{
    <LoadingIndicator />
}
else if (companyContextUnavailable)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
    <a href="/account/company" data-enhance-nav="false">Select an active company</a>
}
else if (batch is null)
{
    <h1>Journal batch not found</h1>
    <p>This batch does not exist in the active company.</p>
    <a href="/financial/journals">Back to journals</a>
}
else
{
    <FinancialDetailLayout Title="@batch.Name" Breadcrumb="Finance / General Journal"
                           BackUrl="/financial/journals" BackLabel="Back to General journals" Status="@($"Status: {batch.Status}")">
    <Commands>
        <a href="/financial/journals">General journals</a>
        @if (batch.Status == JournalBatchStatus.Open)
        {
                <a class="btn btn-outline-secondary" href="@($"/financial/journals/{BatchId}/edit")">Edit batch</a>
                <a class="btn btn-outline-secondary" href="@($"/financial/journals/{BatchId}/lines/new")">Add line</a>
                <button class="btn btn-primary" type="button" disabled="@isSaving" @onclick="PostAsync">
                    @(isSaving ? "Posting..." : "Post batch")
                </button>
        }
        else if (batch.ReversedByBatchId is null && batch.ReversalOfBatchId is null)
        {
            <button class="btn btn-outline-danger" type="button" @onclick="ShowReversalForm">
                Reverse entire batch
            </button>
        }
    </Commands>
    <ChildContent>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (batch.ReversalOfBatchId is { } originalBatchId)
    {
        <div class="alert alert-info" role="status">
            This is the reversing batch for <a href="@($"/financial/journals/{originalBatchId}")">the original batch</a>.
        </div>
    }
    @if (batch.ReversedByBatchId is { } reversalBatchId)
    {
        <div class="alert alert-info" role="status">
            This batch has been reversed by <a href="@($"/financial/journals/{reversalBatchId}")">the reversing batch</a>.
        </div>
    }

    <h2>General</h2>
    <dl class="detail-fields">
        <div><dt>Batch name</dt><dd>@batch.Name</dd></div>
        <div><dt>Status</dt><dd>@batch.Status</dd></div>
        <div><dt>Description</dt><dd>@batch.Description</dd></div>
        <div><dt>Journal template</dt><dd>@batch.TemplateCode</dd></div>
        <div><dt>Default accounting period</dt><dd>@batch.DefaultPeriodName</dd></div>
        <div><dt>Balance (debit minus credit)</dt><dd>@batch.Lines.Sum(line => line.DebitAmount - line.CreditAmount).ToString("N2")</dd></div>
    </dl>
    <h2 class="detail-section">Journal lines</h2>
    @if (batch.Status == JournalBatchStatus.Open)
    {
        <p class="detail-note">Open batches can be edited. Posting permanently locks the lines.</p>
    }
    else
    {
        <p class="detail-note">Posted lines and ledger entries are immutable.</p>
    }

    @if (batch.Lines.Count == 0)
    {
        <div class="alert alert-info" role="status">No journal lines have been added to this batch yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <caption class="visually-hidden">Journal lines in @batch.Name</caption>
                <thead>
                    <tr>
                        <th scope="col">Line</th>
                        <th scope="col">Posting date</th>
                        <th scope="col">Period</th>
                        <th scope="col">G/L account</th>
                        <th scope="col">Document</th>
                        <th scope="col">Description</th>
                        <th scope="col">Tax details</th>
                        <th scope="col">Dimensions</th>
                        <th scope="col" class="text-end">Debit</th>
                        <th scope="col" class="text-end">Credit</th>
                        @if (batch.Status == JournalBatchStatus.Open)
                        {
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in batch.Lines)
                    {
                        <tr>
                            <th scope="row">@line.LineNumber</th>
                            <td>@line.PostingDate.ToString("yyyy-MM-dd")</td>
                            <td>@line.AccountingPeriodName</td>
                            <td>@line.AccountNumber — @line.AccountName</td>
                            <td>@line.DocumentNumber</td>
                            <td>@line.Description</td>
                            <td>
                                @if (line.TaxCode is { } taxCode)
                                {
                                    <span>@taxCode · @line.TaxRatePercent?.ToString("0.####")% · base @line.TaxBaseAmount?.ToString("N4")</span>
                                    <span class="d-block text-body-secondary">@line.TaxPostingType</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>
                                @if (line.Dimensions.Count == 0)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    @string.Join(", ", line.Dimensions.Select(item => $"{item.DimensionCode}: {item.DimensionValueCode}"))
                                }
                            </td>
                            <td class="text-end">@line.DebitAmount.ToString("N2")</td>
                            <td class="text-end">@line.CreditAmount.ToString("N2")</td>
                            @if (batch.Status == JournalBatchStatus.Open)
                            {
                                <td class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@($"/financial/journals/{BatchId}/lines/{line.Id}/edit")">Edit</a>
                                    <button class="btn btn-sm btn-outline-danger ms-1" type="button"
                                            disabled="@isSaving" @onclick="() => DeleteLineAsync(line.Id)">
                                        Delete
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row" colspan="8" class="text-end">Totals</th>
                        <th class="text-end">@batch.Lines.Sum(line => line.DebitAmount).ToString("N2")</th>
                        <th class="text-end">@batch.Lines.Sum(line => line.CreditAmount).ToString("N2")</th>
                        @if (batch.Status == JournalBatchStatus.Open)
                        {
                            <td></td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    @if (showReversalForm)
    {
        <section class="card mt-4" aria-labelledby="reversal-heading">
            <div class="card-body">
                <h2 id="reversal-heading" class="h4">Reverse entire batch</h2>
                <p>The original remains unchanged. A linked reversing batch will be posted with debit and credit sides swapped.</p>
                @if (openPeriods.Count == 0)
                {
                    <div class="alert alert-warning" role="status">
                        An open, unlocked period is required for the reversal.
                        <a href="/financial/accounting-periods">Manage accounting periods</a>
                    </div>
                }
                else
                {
                    <EditForm Model="@reversalInput" OnValidSubmit="ReverseAsync" FormName="reverse-journal-batch">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />
                        <fieldset disabled="@isSaving">
                            <div class="detail-fields">
                                <div>
                                    <label class="form-label" for="reversal-name">Reversing batch name</label>
                                    <InputText id="reversal-name" class="form-control" maxlength="32"
                                               @bind-Value="reversalInput.Name" />
                                    <ValidationMessage For="@(() => reversalInput.Name)" />
                                </div>
                                <div>
                                    <label class="form-label" for="reversal-period">Accounting period</label>
                                    <InputSelect id="reversal-period" class="form-select"
                                                 @bind-Value="reversalInput.AccountingPeriodId"
                                                 @bind-Value:after="AdjustReversalDate">
                                        @foreach (var period in openPeriods)
                                        {
                                            <option value="@period.Id">@period.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label class="form-label" for="reversal-date">Posting date</label>
                                    <InputDate id="reversal-date" class="form-control" TValue="DateOnly"
                                               @bind-Value="reversalInput.PostingDate" />
                                </div>
                                <div>
                                    <label class="form-label" for="reversal-description">Description</label>
                                    <InputText id="reversal-description" class="form-control" maxlength="100"
                                               @bind-Value="reversalInput.Description" />
                                </div>
                            </div>
                        </fieldset>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-danger" type="submit" disabled="@isSaving">
                                @(isSaving ? "Reversing..." : "Post reversal")
                            </button>
                            <button class="btn btn-outline-secondary" type="button" disabled="@isSaving"
                                    @onclick="() => showReversalForm = false">Cancel</button>
                        </div>
                    </EditForm>
                }
            </div>
        </section>
    }
    </ChildContent>
    </FinancialDetailLayout>
}

@code {
    [Parameter]
    public Guid BatchId { get; set; }

    private GeneralJournalBatchDetail? batch;
    private IReadOnlyList<AccountingPeriodListItem> openPeriods = [];
    private readonly GeneralJournalReversalInput reversalInput = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool showReversalForm;
    private bool companyContextUnavailable;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            batch = await GeneralJournalService.GetBatchAsync(user, BatchId);
            openPeriods = (await GeneralJournalService.GetPeriodsAsync(user))
                .Where(period => !period.IsClosed && !period.DateLocked)
                .ToArray();
            if (openPeriods.Count > 0 &&
                !openPeriods.Any(period => period.Id == reversalInput.AccountingPeriodId))
            {
                reversalInput.AccountingPeriodId = openPeriods[0].Id;
                AdjustReversalDate();
            }
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowReversalForm()
    {
        if (batch is null)
        {
            return;
        }

        reversalInput.Name = $"REV-{batch.Name}"[..Math.Min(32, batch.Name.Length + 4)];
        var description = $"Reversal of {batch.Name}";
        reversalInput.Description = description[..Math.Min(100, description.Length)];
        showReversalForm = true;
        AdjustReversalDate();
    }

    private void AdjustReversalDate()
    {
        var period = openPeriods.FirstOrDefault(item => item.Id == reversalInput.AccountingPeriodId);
        if (period is null)
        {
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        reversalInput.PostingDate = today < period.StartsOn
            ? period.StartsOn
            : today > period.EndsOn
                ? period.EndsOn
                : today;
    }

    private async Task DeleteLineAsync(Guid lineId)
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (!await GeneralJournalService.DeleteLineAsync(user, BatchId, lineId))
            {
                errorMessage = "The journal line was not found in this batch.";
            }

            await LoadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task PostAsync()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            await GeneralJournalService.PostBatchAsync(user, BatchId);
            await LoadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ReverseAsync()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var reversalId = await GeneralJournalService.ReverseBatchAsync(user, BatchId, reversalInput);
            Navigation.NavigateTo($"/financial/journals/{reversalId}");
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
