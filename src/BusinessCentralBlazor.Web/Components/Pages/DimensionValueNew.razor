@page "/financial/dimensions/{DimensionId:guid}/values/new"
@attribute [Authorize(Policy = CompanyAuthorizationPolicies.ActiveCompany)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDimensionService DimensionService
@inject NavigationManager Navigation

<PageTitle>New dimension value</PageTitle>
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/financial/dimensions">Dimensions</a></li>
        <li class="breadcrumb-item"><a href="@($"/financial/dimensions/{DimensionId}")">Values</a></li>
        <li class="breadcrumb-item active" aria-current="page">New value</li>
    </ol>
</nav>

@if (isLoading)
{
    <LoadingIndicator />
}
else if (companyContextUnavailable)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
    <a href="/account/company" data-enhance-nav="false">Select an active company</a>
}
else if (dimension is null)
{
    <h1>Dimension not found</h1>
    <p>This dimension does not exist in the active company.</p>
    <a href="/financial/dimensions">Back to dimensions</a>
}
else
{
    <h1>New value for @dimension.Name (@dimension.Code)</h1>
    <DimensionValueForm Model="@input" DimensionId="@DimensionId" SubmitText="Create value"
                        IsSaving="@isSaving" ErrorMessage="@errorMessage" OnValidSubmit="CreateAsync" />
}

@code {
    [Parameter]
    public Guid DimensionId { get; set; }

    private readonly DimensionValueInput input = new();
    private DimensionDetail? dimension;
    private bool isLoading = true;
    private bool isSaving;
    private bool companyContextUnavailable;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            dimension = await DimensionService.GetAsync(user, DimensionId);
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            await DimensionService.CreateValueAsync(user, DimensionId, input);
            Navigation.NavigateTo($"/financial/dimensions/{DimensionId}");
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
