@page "/financial/purchasing"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using BusinessCentralBlazor.Domain.Enums
@attribute [Authorize(Policy = CompanyAuthorizationPolicies.ActiveCompany)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IPurchasingService PurchasingService
@inject NavigationManager Navigation

<PageTitle>Purchasing and payables</PageTitle>
<h1>Purchasing and payables</h1>
<p class="text-body-secondary">
    Create purchase orders, post full receipts to inventory and GRNI, then post vendor invoices at the agreed order prices.
    Partial receipts, price variances, and vendor payments are not included in this slice.
</p>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (isLoading)
{
    <p role="status">Loading purchasing...</p>
}
else
{
    <section class="card mb-4" aria-labelledby="purchasing-setup-heading">
        <div class="card-body">
            <h2 id="purchasing-setup-heading" class="h4">Purchasing setup</h2>
            @if (eligibleLiabilityAccounts.Count == 0)
            {
                <div class="alert alert-info" role="status">
                    Create an unblocked Liability posting account for GRNI and vendor payables.
                </div>
            }
            <EditForm Model="@setupInput" OnValidSubmit="SaveSetupAsync" FormName="purchasing-setup">
                <DataAnnotationsValidator />
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label" for="purchasing-grni">Goods received not invoiced (GRNI) account</label>
                        <InputSelect id="purchasing-grni" class="form-select" @bind-Value="setupInput.GrniAccountId">
                            <option value="@Guid.Empty">Select Liability posting account</option>
                            @foreach (var account in eligibleLiabilityAccounts)
                            {
                                <option value="@account.Id">@account.Number — @account.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-primary" type="submit" disabled="@(isSaving || eligibleLiabilityAccounts.Count == 0)">
                            @(isSaving ? "Saving..." : "Save GRNI account")
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </section>

    <section class="card mb-4" aria-labelledby="vendors-heading">
        <div class="card-body">
            <h2 id="vendors-heading" class="h4">Vendors</h2>
            @if (vendors.Count == 0)
            {
                <p>No vendors have been created for this company.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <caption>Vendors and their payables accounts</caption>
                        <thead><tr><th scope="col">Number</th><th scope="col">Name</th><th scope="col">Payables account</th><th scope="col">Status</th></tr></thead>
                        <tbody>
                            @foreach (var vendor in vendors)
                            {
                                <tr>
                                    <th scope="row">@vendor.Number</th>
                                    <td>@vendor.Name</td>
                                    <td>@vendor.PayablesAccountNumber</td>
                                    <td>@(vendor.IsBlocked ? "Blocked" : "Active")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <h3 class="h5 mt-4">Create vendor</h3>
            <EditForm Model="@vendorInput" OnValidSubmit="CreateVendorAsync" FormName="purchase-vendor">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <fieldset disabled="@isSaving">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" for="purchase-vendor-number">Vendor number</label>
                            <InputText id="purchase-vendor-number" class="form-control" @bind-Value="vendorInput.Number" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="purchase-vendor-name">Name</label>
                            <InputText id="purchase-vendor-name" class="form-control" @bind-Value="vendorInput.Name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="purchase-vendor-account">Payables account</label>
                            <InputSelect id="purchase-vendor-account" class="form-select" @bind-Value="vendorInput.PayablesAccountId">
                                <option value="@Guid.Empty">Select Liability posting account</option>
                                @foreach (var account in eligibleLiabilityAccounts)
                                {
                                    <option value="@account.Id">@account.Number — @account.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <button class="btn btn-primary mt-3" type="submit" disabled="@(!eligibleLiabilityAccounts.Any())">
                        @(isSaving ? "Saving..." : "Create vendor")
                    </button>
                </fieldset>
            </EditForm>
        </div>
    </section>

    <section class="card mb-4" aria-labelledby="purchase-order-heading">
        <div class="card-body">
            <h2 id="purchase-order-heading" class="h4">Create purchase order</h2>
            @if (setup.GoodsReceivedNotInvoicedAccountId is null)
            {
                <div class="alert alert-info" role="status">Select and save a GRNI account before creating purchase orders.</div>
            }
            @if (vendors.All(vendor => vendor.IsBlocked) || items.All(item => item.IsBlocked) || eligibleLiabilityAccounts.Count == 0)
            {
                <div class="alert alert-info" role="status">
                    Create an active vendor, configure inventory items, and select eligible Liability posting accounts.
                    <a href="/financial/inventory">Manage inventory items</a>
                </div>
            }
            <EditForm Model="@orderInput" OnValidSubmit="CreateOrderAsync" FormName="purchase-order">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <fieldset disabled="@isSaving">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" for="purchase-order-number">Order number</label>
                            <InputText id="purchase-order-number" class="form-control" @bind-Value="orderInput.OrderNumber" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="purchase-order-description">Description</label>
                            <InputText id="purchase-order-description" class="form-control" @bind-Value="orderInput.Description" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="purchase-order-date">Order date</label>
                            <InputDate id="purchase-order-date" class="form-control" TValue="DateOnly" @bind-Value="orderInput.OrderDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="purchase-order-vendor">Vendor</label>
                            <InputSelect id="purchase-order-vendor" class="form-select" @bind-Value="orderInput.VendorId">
                                <option value="@Guid.Empty">Select vendor</option>
                                @foreach (var vendor in vendors.Where(candidate => !candidate.IsBlocked))
                                {
                                    <option value="@vendor.Id">@vendor.Number — @vendor.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <h3 class="h5 mt-4">Order lines</h3>
                    @for (var index = 0; index < orderInput.Lines.Count; index++)
                    {
                        var line = orderInput.Lines[index];
                        <div class="row g-3 mb-3 border-bottom pb-3" @key="line">
                            <div class="col-md-4">
                                <label class="form-label" for="@($"purchase-line-item-{index}")">Inventory item</label>
                                <InputSelect id="@($"purchase-line-item-{index}")" class="form-select" @bind-Value="line.ItemId">
                                    <option value="@Guid.Empty">Select item</option>
                                    @foreach (var item in items.Where(candidate => !candidate.IsBlocked))
                                    {
                                        <option value="@item.Id">@item.Number — @item.Description</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="@($"purchase-line-quantity-{index}")">Quantity</label>
                                <InputNumber id="@($"purchase-line-quantity-{index}")" class="form-control" step="0.0001" @bind-Value="line.Quantity" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="@($"purchase-line-cost-{index}")">Unit cost</label>
                                <InputNumber id="@($"purchase-line-cost-{index}")" class="form-control" step="0.0001" @bind-Value="line.UnitCost" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="@($"purchase-line-tax-{index}")">Purchase tax code (optional)</label>
                                <InputSelect id="@($"purchase-line-tax-{index}")" class="form-select" @bind-Value="line.TaxCodeId">
                                    <option value="">No tax</option>
                                    @foreach (var taxCode in taxCodes)
                                    {
                                        <option value="@taxCode.Id">@taxCode.Code — @taxCode.Description</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button class="btn btn-outline-danger" type="button" disabled="@(isSaving || orderInput.Lines.Count == 1)"
                                        aria-label="Remove line" @onclick="() => RemoveOrderLine(line)">Remove</button>
                            </div>
                        </div>
                    }
                    <button class="btn btn-outline-secondary" type="button" disabled="@isSaving" @onclick="AddOrderLine">Add line</button>
                    <button class="btn btn-primary ms-2" type="submit"
                            disabled="@(isSaving || setup.GoodsReceivedNotInvoicedAccountId is null || !vendors.Any(vendor => !vendor.IsBlocked) || !items.Any(item => !item.IsBlocked))">
                        @(isSaving ? "Saving..." : "Create purchase order")
                    </button>
                </fieldset>
            </EditForm>
        </div>
    </section>

    <section class="card mb-4" aria-labelledby="receipt-invoice-heading">
        <div class="card-body">
            <h2 id="receipt-invoice-heading" class="h4">Receive and invoice orders</h2>
            @if (orders.Count == 0)
            {
                <p>Create a purchase order to begin the receipt and vendor invoice workflow.</p>
            }
            else if (periods.Count == 0)
            {
                <div class="alert alert-info" role="status">Create an open, unlocked accounting period before receiving or invoicing.</div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label" for="purchase-process-order">Purchase order</label>
                        <InputSelect id="purchase-process-order" class="form-select" @bind-Value="selectedOrderId">
                            <option value="@Guid.Empty">Select order</option>
                            @foreach (var order in orders.Where(candidate =>
                                candidate.Status is PurchaseOrderStatus.Open or PurchaseOrderStatus.Received))
                            {
                                <option value="@order.Id">@order.OrderNumber — @order.VendorName (@order.Status)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="purchase-period">Accounting period</label>
                        <InputSelect id="purchase-period" class="form-select" @bind-Value="postingInput.AccountingPeriodId">
                            <option value="@Guid.Empty">Select period</option>
                            @foreach (var period in periods)
                            {
                                <option value="@period.Id">@period.Name (@period.StartsOn — @period.EndsOn)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="purchase-posting-date">Posting date</label>
                        <InputDate id="purchase-posting-date" class="form-control" TValue="DateOnly" @bind-Value="postingInput.PostingDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="vendor-invoice-number">Vendor invoice number</label>
                        <InputText id="vendor-invoice-number" class="form-control" @bind-Value="postingInput.DocumentNumber" />
                    </div>
                </div>
                @if (SelectedOrder is { } selected)
                {
                    <p class="mt-3">
                        <strong>@selected.OrderNumber:</strong> @selected.Description — @selected.VendorName.
                        Full receipt quantity: @selected.Lines.Sum(line => line.Quantity).ToString("N4").
                    </p>
                    @if (selected.Status == PurchaseOrderStatus.Open)
                    {
                        <button class="btn btn-primary" type="button" disabled="@isSaving" @onclick="CreateReceiptDraftAsync">
                            Create receipt journal
                        </button>
                    }
                    else if (selected.Status == PurchaseOrderStatus.Received)
                    {
                        <button class="btn btn-primary" type="button" disabled="@isSaving" @onclick="CreateInvoiceDraftAsync">
                            Create vendor invoice journal
                        </button>
                    }
                }
            }
            @if (orders.Count > 0)
            {
                <div class="table-responsive mt-4">
                    <table class="table table-striped align-middle">
                        <caption>Purchase order status and line values</caption>
                        <thead><tr><th scope="col">Order</th><th scope="col">Vendor</th><th scope="col">Order date</th><th scope="col">Lines</th><th scope="col">Status</th></tr></thead>
                        <tbody>
                            @foreach (var order in orders)
                            {
                                <tr>
                                    <th scope="row">@order.OrderNumber</th>
                                    <td>@order.VendorName</td>
                                    <td>@order.OrderDate</td>
                                    <td>@order.Lines.Count</td>
                                    <td>@order.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="card" aria-labelledby="payables-heading">
        <div class="card-body">
            <h2 id="payables-heading" class="h4">Open vendor payables</h2>
            @if (payables.Count == 0)
            {
                <p>No posted vendor invoices are open.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <caption>Posted invoices awaiting vendor payment</caption>
                        <thead><tr><th scope="col">Invoice</th><th scope="col">Posting date</th><th scope="col">Order</th><th scope="col">Vendor</th><th scope="col">Net</th><th scope="col">Tax</th><th scope="col">Open amount</th></tr></thead>
                        <tbody>
                            @foreach (var payable in payables)
                            {
                                <tr>
                                    <th scope="row">@payable.InvoiceNumber</th>
                                    <td>@payable.PostingDate</td>
                                    <td>@payable.OrderNumber</td>
                                    <td>@payable.VendorNumber — @payable.VendorName</td>
                                    <td>@payable.NetAmount.ToString("N2")</td>
                                    <td>@payable.TaxAmount.ToString("N2")</td>
                                    <td>@payable.OpenAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}

@code {
    private readonly SetupInput setupInput = new();
    private readonly PurchaseVendorInput vendorInput = new();
    private readonly PurchaseOrderInput orderInput = new() { Lines = [new PurchaseOrderLineInput()] };
    private readonly PurchaseDocumentPostingInput postingInput = new();
    private PurchasingSetupDetail setup = new(null, []);
    private IReadOnlyList<PurchaseVendorOption> vendors = [];
    private IReadOnlyList<PurchaseItemOption> items = [];
    private IReadOnlyList<PurchaseAccountOption> accounts = [];
    private IReadOnlyList<AccountingPeriodListItem> periods = [];
    private IReadOnlyList<GeneralJournalTaxCodeOption> taxCodes = [];
    private IReadOnlyList<PurchaseOrderDetail> orders = [];
    private IReadOnlyList<PurchasePayableDetail> payables = [];
    private Guid selectedOrderId;
    private bool isLoading = true;
    private bool isSaving;
    private string? statusMessage;
    private string? errorMessage;

    private List<PurchaseAccountOption> eligibleLiabilityAccounts =>
        accounts.Where(account => account.Category == AccountCategory.Liability &&
                                  account.Type == AccountType.Posting &&
                                  account.AllowsDirectPosting && !account.IsBlocked)
            .ToList();

    private PurchaseOrderDetail? SelectedOrder => orders.SingleOrDefault(order => order.Id == selectedOrderId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        setup = await PurchasingService.GetSetupAsync(user);
        accounts = setup.Accounts;
        setupInput.GrniAccountId = setup.GoodsReceivedNotInvoicedAccountId ?? Guid.Empty;
        vendors = await PurchasingService.GetVendorsAsync(user);
        items = await PurchasingService.GetItemsAsync(user);
        periods = await PurchasingService.GetOpenPeriodsAsync(user);
        taxCodes = await PurchasingService.GetTaxCodesAsync(user);
        orders = await PurchasingService.GetOrdersAsync(user);
        payables = await PurchasingService.GetOpenPayablesAsync(user);
    }

    private async Task SaveSetupAsync() =>
        await ExecuteAsync(async user =>
        {
            await PurchasingService.SaveGrniAccountAsync(user, setupInput.GrniAccountId);
            statusMessage = "GRNI liability account saved.";
        });

    private async Task CreateVendorAsync() =>
        await ExecuteAsync(async user =>
        {
            await PurchasingService.CreateVendorAsync(user, vendorInput);
            vendorInput.Number = string.Empty;
            vendorInput.Name = string.Empty;
            vendorInput.PayablesAccountId = Guid.Empty;
            statusMessage = "Vendor created.";
        });

    private async Task CreateOrderAsync() =>
        await ExecuteAsync(async user =>
        {
            selectedOrderId = await PurchasingService.CreateOrderAsync(user, orderInput);
            orderInput.OrderNumber = string.Empty;
            orderInput.Description = string.Empty;
            orderInput.VendorId = Guid.Empty;
            orderInput.OrderDate = DateOnly.FromDateTime(DateTime.Today);
            orderInput.Lines = [new PurchaseOrderLineInput()];
            statusMessage = "Purchase order created.";
        });

    private async Task CreateReceiptDraftAsync()
    {
        if (SelectedOrder is not { } order)
        {
            return;
        }
        await CreateDocumentDraftAsync(
            order,
            (user, id) => PurchasingService.CreateReceiptDraftAsync(user, id, postingInput),
            "Receipt journal draft created. Review and post it to increase inventory and credit GRNI.");
    }

    private async Task CreateInvoiceDraftAsync()
    {
        if (SelectedOrder is not { } order)
        {
            return;
        }
        await CreateDocumentDraftAsync(
            order,
            (user, id) => PurchasingService.CreateInvoiceDraftAsync(user, id, postingInput),
            "Vendor invoice journal draft created. Review and post it to clear GRNI and record tax and payables.");
    }

    private async Task CreateDocumentDraftAsync(
        PurchaseOrderDetail order,
        Func<ClaimsPrincipal, Guid, Task<Guid>> createDraft,
        string message) =>
        await ExecuteAsync(async user =>
        {
            var batchId = await createDraft(user, order.Id);
            statusMessage = message;
            Navigation.NavigateTo($"/financial/journals/{batchId}");
        });

    private async Task ExecuteAsync(Func<ClaimsPrincipal, Task> action)
    {
        if (isSaving)
        {
            return;
        }
        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            await action(user);
            await LoadAsync();
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AddOrderLine() => orderInput.Lines.Add(new PurchaseOrderLineInput());

    private void RemoveOrderLine(PurchaseOrderLineInput line)
    {
        if (orderInput.Lines.Count > 1)
        {
            orderInput.Lines.Remove(line);
        }
    }

    private sealed class SetupInput
    {
        public Guid GrniAccountId { get; set; }
    }
}
