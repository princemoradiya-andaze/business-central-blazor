@page "/financial/sales"
@page "/financial/sales/customers"
@page "/financial/sales/customers/new"
@page "/financial/sales/customers/{CustomerId:guid}/edit"
@implements IDisposable
@attribute [Authorize(Policy = CompanyAuthorizationPolicies.ActiveCompany)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISalesService SalesService
@inject NavigationManager Navigation
<PageTitle>@CurrentSectionTitle</PageTitle>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}
@if (CurrentSection != "new-customer" && !string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (isLoading)
{
    <LoadingIndicator />
}
else
{
    @if (CurrentSection is "customers" or "new-customer" or "edit-customer")
    {
        <section class="customer-workspace" aria-label="Customers">
            <div class="customer-action-bar" aria-label="Customer actions">
                <h1>Customers</h1>
                <span class="customer-command-separator" aria-hidden="true"></span>
                <div class="customer-view-filter-container" @onkeydown="HandleCustomerStatusKeyDown">
                    <label class="visually-hidden" for="customer-status">Filter customers</label>
                    <button id="customer-status" class="customer-view-filter"
                            type="button"
                            aria-haspopup="menu"
                            aria-expanded="@(isCustomerStatusMenuOpen ? "true" : "false")"
                            aria-controls="customer-status-options"
                            @onclick="ToggleCustomerStatusMenu">
                        @CustomerStatusFilterLabel
                        <span class="customer-view-filter-chevron" aria-hidden="true"></span>
                    </button>
                    <div id="customer-status-options" class="customer-view-filter-menu"
                         role="menu" aria-label="Customer status"
                         hidden="@(!isCustomerStatusMenuOpen)">
                        @foreach (var option in CustomerStatusFilterOptions)
                        {
                            <button class="customer-view-filter-option" type="button"
                                    role="menuitemradio"
                                    aria-checked="@(customerStatusFilter == option.Value ? "true" : "false")"
                                    @onclick="() => SetCustomerStatusFilter(option.Value)">
                                <span class="customer-view-filter-check" aria-hidden="true">
                                    @(customerStatusFilter == option.Value ? "✓" : string.Empty)
                                </span>
                                <span>@option.Label</span>
                            </button>
                        }
                    </div>
                </div>
                <button class="customer-search-toggle" type="button"
                        aria-label="Search customers"
                        aria-expanded="@(isCustomerSearchExpanded ? "true" : "false")"
                        aria-controls="customer-search"
                        title="Search customers"
                        @onclick="ToggleCustomerSearch">
                    <span class="customer-search-icon" aria-hidden="true"></span>
                </button>
                <label class="visually-hidden" for="customer-search">Search customers</label>
                <input id="customer-search"
                       @ref="customerSearchInput"
                       class="customer-search-input @(isCustomerSearchExpanded ? "expanded" : null)"
                       type="search"
                       placeholder="Search customers"
                       disabled="@(!isCustomerSearchExpanded)"
                       tabindex="@(isCustomerSearchExpanded ? 0 : -1)"
                       aria-hidden="@(isCustomerSearchExpanded ? "false" : "true")"
                       @bind="customerSearchTerm"
                       @bind:event="oninput"
                       @bind:after="ClearCustomerSelection"
                       @onkeydown="HandleCustomerSearchKeyDown" />
                <span class="customer-command-separator" aria-hidden="true"></span>
                <div class="customer-actions">
                    <a class="customer-action-button" href="/financial/sales/customers/new"><span class="workspace-new-icon" aria-hidden="true"></span>New</a>
                    <span class="customer-command-separator" aria-hidden="true"></span>
                    @if (SelectedCustomer is { IsInactive: true })
                    {
                        <button class="customer-action-button" type="button" @onclick="ReactivateSelectedCustomerAsync">
                            Activate
                        </button>
                    }
                    else
                    {
                        <button class="customer-action-button" type="button"
                                disabled="@(SelectedCustomer is null)"
                                @onclick="RequestCustomerDeactivation">
                            Delete
                        </button>
                    }
                    <span class="customer-command-separator" aria-hidden="true"></span>
                </div>
                <div class="customer-view-controls" role="group" aria-label="Customer view options">
                    <button id="customer-filter-toggle" class="customer-view-control @(isCustomerFilterPaneOpen ? "active" : null)"
                            type="button" aria-label="Filters" title="Filters"
                            aria-pressed="@(isCustomerFilterPaneOpen ? "true" : "false")"
                            aria-controls="customer-filter-pane"
                            @onclick="ToggleCustomerFilterPane">
                        <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M2 3h12L9.2 8.4v4l-2.4 1.3V8.4z" /></svg>
                    </button>
                    <div class="customer-view-menu-container">
                        <button id="customer-view-toggle" class="customer-view-control @(isCustomerViewMenuOpen ? "active" : null)"
                                type="button" aria-label="Choose customer view" title="Choose view"
                                aria-haspopup="menu" aria-expanded="@(isCustomerViewMenuOpen ? "true" : "false")"
                                aria-controls="customer-view-menu"
                                @onclick="ToggleCustomerViewMenu">
                            <WorkspaceViewIcon View="@customerView" />
                        </button>
                        <div id="customer-view-menu" class="customer-view-menu"
                             role="menu" aria-label="Customer view"
                             hidden="@(!isCustomerViewMenuOpen)">
                            @foreach (var option in CustomerViewOptions)
                            {
                                <button class="customer-view-option" type="button"
                                        role="menuitemradio"
                                        aria-checked="@(customerView == option.Value ? "true" : "false")"
                                        @onclick="() => SetCustomerView(option.Value)">
                                    <span class="customer-view-check" aria-hidden="true">
                                        @(customerView == option.Value ? "✓" : string.Empty)
                                    </span>
                                    <span class="customer-view-option-icon" aria-hidden="true">@option.Icon</span>
                                    <span>@option.Label</span>
                                </button>
                            }
                        </div>
                    </div>
                    <button id="customer-details-toggle" class="customer-view-control @(isCustomerDetailsPaneOpen ? "active" : null)"
                            type="button" aria-label="Customer details" title="Customer details"
                            aria-pressed="@(isCustomerDetailsPaneOpen ? "true" : "false")"
                            aria-controls="customer-details-pane"
                            @onclick="ToggleCustomerDetailsPane">
                        <svg aria-hidden="true" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" /><path d="M8 7v4M8 4.5v.1" /></svg>
                    </button>
                </div>
            </div>
            @if (PendingDeactivationCustomer is { } pendingCustomer)
            {
                <div class="alert alert-warning customer-deactivation-confirmation" role="alert">
                    <span>Delete @pendingCustomer.Name? The customer will be marked Inactive and can be reactivated later.</span>
                    <button class="btn btn-sm btn-danger" type="button" @onclick="DeactivateCustomerAsync">Confirm delete</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelCustomerDeactivation">Cancel</button>
                </div>
            }
            <div class="@CustomerLayoutClass">
                <aside id="customer-filter-pane" class="customer-filter-pane"
                       aria-label="Customer filters" hidden="@(!isCustomerFilterPaneOpen)">
                    <div class="customer-pane-heading">
                        <h2>Filters</h2>
                        <button class="customer-pane-close" type="button" aria-label="Close filters"
                                @onclick="ToggleCustomerFilterPane">×</button>
                    </div>
                    <label for="customer-filter-search">Name or number</label>
                    <input id="customer-filter-search" class="form-control"
                           value="@customerSearchTerm"
                           @oninput="HandleCustomerFilterSearchInput" />
                    <label for="customer-filter-status">Status</label>
                    <select id="customer-filter-status" class="form-select"
                            value="@customerStatusFilter"
                            @onchange="HandleCustomerFilterStatusChanged">
                        @foreach (var option in CustomerStatusFilterOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                    <button class="customer-filter-clear" type="button" @onclick="ClearCustomerFilters">
                        Clear filters
                    </button>
                </aside>
                <div class="customer-records">
                    @if (!FilteredCustomers.Any())
                    {
                        <p class="customer-empty-state">@(customers.Count == 0
                            ? "No sales customers have been created for this company."
                            : "No customers match the current search and status filter.")</p>
                    }
                    else if (customerView == "list")
                    {
                        <div class="table-responsive">
                            <table class="table customer-table align-middle">
                                <caption>Sales customers and their receivables accounts</caption>
                                <thead>
                                    <tr><th scope="col">No.</th><th scope="col">Name</th><th scope="col">Receivables account</th><th scope="col">Status</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var customer in FilteredCustomers)
                                    {
                                        <tr class="@(selectedCustomerId == customer.Id ? "customer-row-selected" : null)"
                                            @onclick="() => SelectCustomer(customer.Id)">
                                            <th scope="row">
                                                <a class="customer-number-select" href="@($"/financial/sales/customers/{customer.Id}/edit")" @onclick:stopPropagation="true">@customer.Number</a>
                                            </th>
                                            <td>@customer.Name</td>
                                            <td>@customer.ReceivablesAccountNumber</td>
                                            <td>@CustomerStatus(customer)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="customer-tile-grid @(customerView == "tiles" ? "customer-tile-grid-compact" : null)">
                            @foreach (var customer in FilteredCustomers)
                            {
                                <div class="customer-tile @(selectedCustomerId == customer.Id ? "customer-tile-selected" : null)"
                                     @onclick="() => SelectCustomer(customer.Id)" tabindex="0" role="group" @onkeydown='args => { if (args.Key is "Enter" or " ") SelectCustomer(customer.Id); }'>
                                    <span class="customer-tile-avatar" aria-hidden="true">
                                        <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="27" /><circle cx="32" cy="23" r="8" /><path d="M16 51c1-10 7-15 16-15s15 5 16 15" /></svg>
                                    </span>
                                    <span class="customer-tile-details">
                                        <a class="customer-tile-number" href="@($"/financial/sales/customers/{customer.Id}/edit")" @onclick:stopPropagation="true">@customer.Number</a>
                                        <span class="customer-tile-name">@customer.Name</span>
                                        <span class="customer-tile-meta">Receivables account: @customer.ReceivablesAccountNumber</span>
                                        <span class="customer-tile-meta">Status: @CustomerStatus(customer)</span>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <aside id="customer-details-pane" class="customer-details-pane"
                       aria-label="Customer details" hidden="@(!isCustomerDetailsPaneOpen)">
                    <div class="customer-pane-heading">
                        <h2>Customer details</h2>
                        <button class="customer-pane-close" type="button" aria-label="Close customer details"
                                @onclick="ToggleCustomerDetailsPane">×</button>
                    </div>
                    @if (SelectedCustomer is { } detailsCustomer)
                    {
                        <h3 class="customer-details-name">@detailsCustomer.Name</h3>
                        <dl class="customer-details-list">
                            <div><dt>Customer number</dt><dd>@detailsCustomer.Number</dd></div>
                            <div><dt>Receivables account</dt><dd>@detailsCustomer.ReceivablesAccountNumber</dd></div>
                            <div><dt>Status</dt><dd>@CustomerStatus(detailsCustomer)</dd></div>
                        </dl>
                    }
                    else
                    {
                        <p class="customer-details-empty">Select a customer to see its details.</p>
                    }
                </aside>
            </div>
        </section>
    }

    @if (CurrentSection == "new-customer" || CurrentSection == "edit-customer" && editingCustomerAvailable)
    {
        <EntityRecordCard Model="@customerInput" Save="PersistCustomerAsync"
                          Module="Customers" CardType="Customer Card" Title="@(customerInput.Number + " - " + customerInput.Name)"
                          IsNew="@(!CustomerId.HasValue)" OnClose="CloseCustomerCard"
                          CanPrevious="@(BrowseTarget(-1).HasValue)" CanNext="@(BrowseTarget(1).HasValue)" OnBrowse="BrowseAsync"
                          ReturnFocusSelector="@(CustomerId.HasValue ? $"a[href='/financial/sales/customers/{CustomerId}/edit']" : ".customer-actions a")"
                          ReturnFocusFallbackSelector=".customer-actions a">
                                @if (!EligibleReceivablesAccounts.Any())
                    {
                        <div class="alert alert-info" role="status">
                            Create an unblocked Asset posting account for accounts receivable before adding a customer.
                        </div>
                    }
                    <fieldset>
                        <div class="customer-card-fields">
                            <div class="customer-card-column">
                                <div class="customer-card-field">
                                    <label for="sales-customer-number">No. <span aria-hidden="true">*</span></label>
                                    <CardInputText id="sales-customer-number" class="form-control" aria-label="Customer number" aria-required="true" maxlength="32" autofocus @bind-Value="customerInput.Number" />
                                </div>
                                <ValidationMessage For="@(() => customerInput.Number)" />
                                <div class="customer-card-field">
                                    <label for="sales-customer-name">Name <span aria-hidden="true">*</span></label>
                                    <CardInputText id="sales-customer-name" class="form-control" aria-required="true" maxlength="160" @bind-Value="customerInput.Name" />
                                </div>
                                <ValidationMessage For="@(() => customerInput.Name)" />
                            </div>
                            <div class="customer-card-column">
                                <div class="customer-card-field">
                                    <label for="sales-customer-ar">Receivables account <span aria-hidden="true">*</span></label>
                                    <InputSelect id="sales-customer-ar" class="form-select" aria-required="true" @bind-Value="customerInput.ReceivablesAccountId">
                                        <option value="@Guid.Empty">Select Asset posting account</option>
                                        @foreach (var account in EligibleReceivablesAccounts)
                                        {
                                            <option value="@account.Id">@account.Number - @account.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                    </fieldset>
        </EntityRecordCard>
    }

}

@code {
    private void EnsureSelection() => selectedCustomerId = RecordSelection.Reconcile(FilteredCustomers.Select(record => record.Id), selectedCustomerId);
    private Guid? BrowseTarget(int offset) => CustomerId is { } id
        ? RecordSelection.Adjacent(FilteredCustomers.Select(record => record.Id), id, offset) : null;
    private Task BrowseAsync(int offset)
    {
        if (BrowseTarget(offset) is { } id)
            Navigation.NavigateTo($"/financial/sales/customers/{id}/edit");
        else
            CloseCustomerCard();
        return Task.CompletedTask;
    }
    private async Task PersistCustomerAsync(SalesCustomerInput snapshot)
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (CustomerId is { } id)
            await SalesService.UpdateCustomerAsync(user, id, snapshot);
        else
            await SalesService.CreateCustomerAsync(user, snapshot);
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<SalesCustomerOption> customers = [];
    private IReadOnlyList<SalesAccountOption> accounts = [];
    private SalesCustomerInput customerInput = new();
    private bool editingCustomerAvailable;
    private bool isLoading = true;
    private bool isSaving;
    private string? statusMessage;
    private string? errorMessage;
    private string customerSearchTerm = string.Empty;
    private string customerStatusFilter = "all";
    private bool isCustomerStatusMenuOpen;
    private Guid? selectedCustomerId;
    private Guid? pendingDeactivationCustomerId;
    private bool isCustomerSearchExpanded;
    private bool isCustomerFilterPaneOpen;
    private bool isCustomerDetailsPaneOpen;
    private bool isCustomerViewMenuOpen;
    private string customerView = "list";
    private ElementReference customerSearchInput;

    [Parameter]
    public Guid? CustomerId { get; set; }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (new Uri(args.Location).AbsolutePath.TrimEnd('/').EndsWith("/customers/new", StringComparison.OrdinalIgnoreCase))
            customerInput = new();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private string CurrentSection => CurrentPath switch
    {
        "/financial/sales/customers/new" => "new-customer",
        _ when CurrentPath.EndsWith("/edit", StringComparison.OrdinalIgnoreCase) => "edit-customer",
        _ => "customers"
    };
    private string CurrentPath => ("/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0])
        .ToLowerInvariant();
    private string CurrentSectionTitle => CurrentSection switch
    {
        "customers" => "Customers",
        "new-customer" => "New customer",
        "edit-customer" => "Edit customer",
        _ => "Sales"
    };

    private string CustomerStatusFilterLabel => CustomerStatusFilterOptions
        .Single(option => option.Value == customerStatusFilter).Label;
    private static readonly (string Value, string Label)[] CustomerStatusFilterOptions =
    [
        ("all", "All"),
        ("active", "Active"),
        ("blocked", "Blocked"),
        ("inactive", "Inactive")
    ];
    private static readonly (string Value, string Label, string Icon)[] CustomerViewOptions =
    [
        ("list", "List", "☷"),
        ("tall-tiles", "Tall tiles", "▣"),
        ("tiles", "Tiles", "▦")
    ];
    private string CustomerLayoutClass =>
        $"customer-layout{(isCustomerFilterPaneOpen ? " customer-filter-open" : string.Empty)}" +
        $"{(isCustomerDetailsPaneOpen ? " customer-details-open" : string.Empty)}";

    private IEnumerable<SalesCustomerOption> FilteredCustomers => customers.Where(customer =>
        (customerStatusFilter switch
        {
            "active" => !customer.IsInactive && !customer.IsBlocked,
            "blocked" => !customer.IsInactive && customer.IsBlocked,
            "inactive" => customer.IsInactive,
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(customerSearchTerm) ||
         customer.Number.Contains(customerSearchTerm, StringComparison.OrdinalIgnoreCase) ||
         customer.Name.Contains(customerSearchTerm, StringComparison.OrdinalIgnoreCase)));
    private SalesCustomerOption? SelectedCustomer => FilteredCustomers
        .SingleOrDefault(customer => customer.Id == selectedCustomerId);
    private SalesCustomerOption? PendingDeactivationCustomer => customers
        .SingleOrDefault(customer => customer.Id == pendingDeactivationCustomerId);
    private IReadOnlyList<SalesAccountOption> EligibleReceivablesAccounts => accounts
        .Where(account => account.Category == AccountCategory.Asset &&
                          !account.IsBlocked)
        .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (isLoading) await LoadAsync();
            customerInput = new();
            editingCustomerAvailable = CurrentSection == "new-customer";
            if (CurrentSection == "edit-customer" && CustomerId is { } customerId)
            {
                var customer = customers.SingleOrDefault(candidate => candidate.Id == customerId);
                if (customer is null)
                {
                    errorMessage = "The customer is not available in the active company.";
                }
                else
                {
                    editingCustomerAvailable = true;
                    selectedCustomerId = customer.Id;
                    customerInput.Number = customer.Number;
                    customerInput.Name = customer.Name;
                    customerInput.ReceivablesAccountId = customer.ReceivablesAccountId;
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var loadedCustomers = await SalesService.GetCustomersAsync(user);
        var loadedAccounts = await SalesService.GetSalesAccountsAsync(user);
        customers = loadedCustomers;
        EnsureSelection();
        accounts = loadedAccounts;
    }



    private void CloseCustomerCard()
    {
        errorMessage = null;
        Navigation.NavigateTo("/financial/sales/customers");
    }



    private void SelectCustomer(Guid customerId)
    {
        selectedCustomerId = customerId;
        pendingDeactivationCustomerId = null;
    }

    private void ClearCustomerSelection()
    {
        EnsureSelection();
        pendingDeactivationCustomerId = null;
    }

    private void ToggleCustomerStatusMenu()
    {
        isCustomerStatusMenuOpen = !isCustomerStatusMenuOpen;
    }

    private void CloseCustomerStatusMenu()
    {
        isCustomerStatusMenuOpen = false;
    }

    private void SetCustomerStatusFilter(string filter)
    {
        customerStatusFilter = filter;
        isCustomerStatusMenuOpen = false;
        ClearCustomerSelection();
    }

    private void HandleCustomerFilterSearchInput(ChangeEventArgs args)
    {
        customerSearchTerm = args.Value?.ToString() ?? string.Empty;
        ClearCustomerSelection();
    }

    private void HandleCustomerFilterStatusChanged(ChangeEventArgs args) =>
        SetCustomerStatusFilter(args.Value?.ToString() ?? "all");

    private void ClearCustomerFilters()
    {
        customerSearchTerm = string.Empty;
        customerStatusFilter = "all";
        ClearCustomerSelection();
    }

    private void ToggleCustomerFilterPane() =>
        isCustomerFilterPaneOpen = !isCustomerFilterPaneOpen;

    private void ToggleCustomerDetailsPane() =>
        isCustomerDetailsPaneOpen = !isCustomerDetailsPaneOpen;

    private void ToggleCustomerViewMenu() =>
        isCustomerViewMenuOpen = !isCustomerViewMenuOpen;

    private void SetCustomerView(string view)
    {
        if (CustomerViewOptions.Any(option => option.Value == view))
        {
            customerView = view;
        }

        isCustomerViewMenuOpen = false;
    }

    private Task HandleCustomerStatusKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseCustomerStatusMenu();
        }

        return Task.CompletedTask;
    }

    private async Task ToggleCustomerSearch()
    {
        isCustomerSearchExpanded = !isCustomerSearchExpanded;
        if (isCustomerSearchExpanded)
        {
            await InvokeAsync(StateHasChanged);
            await customerSearchInput.FocusAsync();
            return;
        }

        customerSearchTerm = string.Empty;
        ClearCustomerSelection();
    }

    private Task HandleCustomerSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && isCustomerSearchExpanded)
        {
            return ToggleCustomerSearch();
        }

        return Task.CompletedTask;
    }



    private void RequestCustomerDeactivation()
    {
        if (SelectedCustomer is { IsInactive: false } customer)
        {
            pendingDeactivationCustomerId = customer.Id;
        }
    }

    private void CancelCustomerDeactivation() => pendingDeactivationCustomerId = null;

    private async Task DeactivateCustomerAsync()
    {
        if (PendingDeactivationCustomer is not { IsInactive: false } customer)
        {
            return;
        }

        await ExecuteAsync(async user =>
        {
            await SalesService.SetCustomerInactiveAsync(user, customer.Id, true);
            EnsureSelection();
            pendingDeactivationCustomerId = null;
            statusMessage = "Customer marked inactive.";
        });
    }

    private async Task ReactivateSelectedCustomerAsync()
    {
        if (SelectedCustomer is not { IsInactive: true } customer)
        {
            return;
        }

        await ExecuteAsync(async user =>
        {
            await SalesService.SetCustomerInactiveAsync(user, customer.Id, false);
            EnsureSelection();
            customerStatusFilter = "all";
            statusMessage = "Customer reactivated.";
        });
    }

    private static string CustomerStatus(SalesCustomerOption customer) =>
        customer.IsInactive ? "Inactive" : customer.IsBlocked ? "Blocked" : "Active";

    private async Task ExecuteAsync(Func<System.Security.Claims.ClaimsPrincipal, Task> action)
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            await action(user);
            await LoadAsync();
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
