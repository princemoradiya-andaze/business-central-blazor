@page "/financial/sales"
@page "/financial/sales/customers"
@page "/financial/sales/customers/new"
@page "/financial/sales/customers/{CustomerId:guid}/edit"
@page "/financial/sales/create-order"
@page "/financial/sales/orders"
@page "/financial/sales/fulfillment"
@page "/financial/sales/receivables"
@attribute [Authorize(Policy = CompanyAuthorizationPolicies.ActiveCompany)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISalesService SalesService
@inject NavigationManager Navigation

<PageTitle>@CurrentSectionTitle</PageTitle>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (isLoading)
{
    <p role="status">Loading @CurrentSectionTitle.ToLowerInvariant()...</p>
}
else
{
    @if (CurrentSection == "customers")
    {
        <section class="customer-workspace" aria-label="Customers">
            <div class="customer-action-bar" aria-label="Customer actions">
                <h1>Customers</h1>
                <span class="customer-command-separator" aria-hidden="true"></span>
                <div class="customer-view-filter-container" @onkeydown="HandleCustomerStatusKeyDown">
                    <label class="visually-hidden" for="customer-status">Filter customers</label>
                    <button id="customer-status" class="customer-view-filter"
                            type="button"
                            aria-haspopup="menu"
                            aria-expanded="@isCustomerStatusMenuOpen"
                            aria-controls="customer-status-options"
                            @onclick="ToggleCustomerStatusMenu">
                        @CustomerStatusFilterLabel
                        <span class="customer-view-filter-chevron" aria-hidden="true"></span>
                    </button>
                    <div id="customer-status-options" class="customer-view-filter-menu"
                         role="menu" aria-label="Customer status"
                         hidden="@(!isCustomerStatusMenuOpen)">
                        @foreach (var option in CustomerStatusFilterOptions)
                        {
                            <button class="customer-view-filter-option" type="button"
                                    role="menuitemradio"
                                    aria-checked="@(customerStatusFilter == option.Value)"
                                    @onclick="() => SetCustomerStatusFilter(option.Value)">
                                <span class="customer-view-filter-check" aria-hidden="true">
                                    @(customerStatusFilter == option.Value ? "✓" : string.Empty)
                                </span>
                                <span>@option.Label</span>
                            </button>
                        }
                    </div>
                </div>
                <button class="customer-search-toggle" type="button"
                        aria-label="Search customers"
                        aria-expanded="@(isCustomerSearchExpanded ? "true" : "false")"
                        aria-controls="customer-search"
                        title="Search customers"
                        @onclick="ToggleCustomerSearch">
                    <span class="customer-search-icon" aria-hidden="true"></span>
                </button>
                <label class="visually-hidden" for="customer-search">Search customers</label>
                <input id="customer-search"
                       @ref="customerSearchInput"
                       class="customer-search-input @(isCustomerSearchExpanded ? "expanded" : null)"
                       type="search"
                       placeholder="Search customers"
                       disabled="@(!isCustomerSearchExpanded)"
                       tabindex="@(isCustomerSearchExpanded ? 0 : -1)"
                       aria-hidden="@(isCustomerSearchExpanded ? "false" : "true")"
                       @bind="customerSearchTerm"
                       @bind:event="oninput"
                       @bind:after="ClearCustomerSelection"
                       @onkeydown="HandleCustomerSearchKeyDown" />
                <span class="customer-command-separator" aria-hidden="true"></span>
                <div class="customer-actions">
                    <a class="customer-action-button" href="/financial/sales/customers/new">+ New</a>
                    <span class="customer-command-separator" aria-hidden="true"></span>
                    <button class="customer-action-button" type="button"
                            disabled="@(SelectedCustomer is null)"
                            @onclick="EditSelectedCustomer">
                        Edit
                    </button>
                    <span class="customer-command-separator" aria-hidden="true"></span>
                    @if (SelectedCustomer is { IsInactive: true })
                    {
                        <button class="customer-action-button" type="button" @onclick="ReactivateSelectedCustomerAsync">
                            Activate
                        </button>
                    }
                    else
                    {
                        <button class="customer-action-button" type="button"
                                disabled="@(SelectedCustomer is null)"
                                @onclick="RequestCustomerDeactivation">
                            Delete
                        </button>
                    }
                    <span class="customer-command-separator" aria-hidden="true"></span>
                </div>
            </div>
            @if (PendingDeactivationCustomer is { } pendingCustomer)
            {
                <div class="alert alert-warning customer-deactivation-confirmation" role="alert">
                    <span>Delete @pendingCustomer.Name? The customer will be marked Inactive and can be reactivated later.</span>
                    <button class="btn btn-sm btn-danger" type="button" @onclick="DeactivateCustomerAsync">Confirm delete</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelCustomerDeactivation">Cancel</button>
                </div>
            }
            @if (!FilteredCustomers.Any())
            {
                <p>@(customers.Count == 0
                    ? "No sales customers have been created for this company."
                    : "No customers match the current search and status filter.")</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table customer-table align-middle">
                        <caption>Sales customers and their receivables accounts</caption>
                        <thead>
                            <tr><th scope="col">No.</th><th scope="col">Name</th><th scope="col">Receivables account</th><th scope="col">Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in FilteredCustomers)
                            {
                                <tr class="@(selectedCustomerId == customer.Id ? "customer-row-selected" : null)">
                                    <th scope="row">
                                        <button class="customer-number-select" type="button"
                                                aria-pressed="@(selectedCustomerId == customer.Id)"
                                                @onclick="() => SelectCustomer(customer.Id)">
                                            @customer.Number
                                        </button>
                                    </th>
                                    <td>@customer.Name</td>
                                    <td>@customer.ReceivablesAccountNumber</td>
                                    <td>@CustomerStatus(customer)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (CurrentSection == "edit-customer")
    {
        <section aria-labelledby="edit-customer-heading">
            <h2 id="edit-customer-heading" class="h4">Edit customer</h2>
            @if (!EligibleReceivablesAccounts.Any())
            {
                <div class="alert alert-info" role="status">
                    Create an unblocked Asset posting account for accounts receivable before editing a customer.
                </div>
            }
            <EditForm Model="@customerInput" OnValidSubmit="UpdateCustomerAsync" FormName="edit-sales-customer">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <fieldset disabled="@isSaving">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" for="sales-customer-number">Customer number</label>
                            <InputText id="sales-customer-number" class="form-control" @bind-Value="customerInput.Number" />
                            <ValidationMessage For="@(() => customerInput.Number)" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="sales-customer-name">Name</label>
                            <InputText id="sales-customer-name" class="form-control" @bind-Value="customerInput.Name" />
                            <ValidationMessage For="@(() => customerInput.Name)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="sales-customer-ar">Receivables account</label>
                            <InputSelect id="sales-customer-ar" class="form-select" @bind-Value="customerInput.ReceivablesAccountId">
                                <option value="@Guid.Empty">Select Asset posting account</option>
                                @foreach (var account in EligibleReceivablesAccounts)
                                {
                                    <option value="@account.Id">@account.Number - @account.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <button class="btn btn-primary mt-3" type="submit" disabled="@(!EligibleReceivablesAccounts.Any())">
                        @(isSaving ? "Saving..." : "Save")
                    </button>
                    <a class="btn btn-outline-secondary mt-3" href="/financial/sales/customers">Cancel</a>
                </fieldset>
            </EditForm>
        </section>
    }

    @if (CurrentSection == "new-customer")
    {
        <section aria-labelledby="new-customer-heading">
            <h2 id="new-customer-heading" class="h4">New customer</h2>
            @if (!EligibleReceivablesAccounts.Any())
            {
                <div class="alert alert-info" role="status">
                    Create an unblocked Asset posting account for accounts receivable before adding a customer.
                </div>
            }
            <EditForm Model="@customerInput" OnValidSubmit="CreateCustomerAsync" FormName="sales-customer">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <fieldset disabled="@isSaving">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" for="sales-customer-number">Customer number</label>
                            <InputText id="sales-customer-number" class="form-control" @bind-Value="customerInput.Number" />
                            <ValidationMessage For="@(() => customerInput.Number)" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="sales-customer-name">Name</label>
                            <InputText id="sales-customer-name" class="form-control" @bind-Value="customerInput.Name" />
                            <ValidationMessage For="@(() => customerInput.Name)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="sales-customer-ar">Receivables account</label>
                            <InputSelect id="sales-customer-ar" class="form-select" @bind-Value="customerInput.ReceivablesAccountId">
                                <option value="@Guid.Empty">Select Asset posting account</option>
                                @foreach (var account in EligibleReceivablesAccounts)
                                {
                                    <option value="@account.Id">@account.Number - @account.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <button class="btn btn-primary mt-3" type="submit" disabled="@(!EligibleReceivablesAccounts.Any())">
                        @(isSaving ? "Saving..." : "Save")
                    </button>
                </fieldset>
            </EditForm>
        </section>
    }

    @if (CurrentSection == "create-order")
    {
    <section class="sales-workflow-section" aria-labelledby="sales-order-heading">
        <div class="card-body">
            <h2 id="sales-order-heading" class="h4">Create sales order</h2>
            @if (!EligibleCustomers.Any() || EligibleItems.Count == 0 || EligibleSalesAccounts.Count == 0)
            {
                <div class="alert alert-info" role="status">
                    To create an order, add an active customer, an active inventory item, and an Income posting account.
                    @if (EligibleItems.Count == 0)
                    {
                        <a href="/financial/inventory">Set up inventory items</a>
                    }
                    @if (EligibleSalesAccounts.Count == 0)
                    {
                        <a href="/financial/general-ledger/accounts">Set up sales accounts</a>
                    }
                </div>
            }
            <EditForm Model="@orderInput" OnValidSubmit="CreateOrderAsync" FormName="sales-order">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <fieldset disabled="@isSaving">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" for="sales-order-number">Order number</label>
                            <InputText id="sales-order-number" class="form-control" @bind-Value="orderInput.OrderNumber" />
                            <ValidationMessage For="@(() => orderInput.OrderNumber)" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="sales-order-description">Description</label>
                            <InputText id="sales-order-description" class="form-control" @bind-Value="orderInput.Description" />
                            <ValidationMessage For="@(() => orderInput.Description)" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="sales-order-date">Order date</label>
                            <InputDate id="sales-order-date" class="form-control" TValue="DateOnly" @bind-Value="orderInput.OrderDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="sales-order-customer">Customer</label>
                            <InputSelect id="sales-order-customer" class="form-select" @bind-Value="orderInput.CustomerId">
                                <option value="@Guid.Empty">Select customer</option>
                                @foreach (var customer in EligibleCustomers)
                                {
                                    <option value="@customer.Id">@customer.Number - @customer.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <h3 class="h5 mt-4">Order lines</h3>
                    @for (var index = 0; index < orderInput.Lines.Count; index++)
                    {
                        var line = orderInput.Lines[index];
                        <div class="row g-3 mb-3 border-bottom pb-3" @key="line">
                            <div class="col-md-4">
                                <label class="form-label" for="@($"sales-line-item-{index}")">Inventory item</label>
                                <InputSelect id="@($"sales-line-item-{index}")" class="form-select" @bind-Value="line.ItemId">
                                    <option value="@Guid.Empty">Select item</option>
                                    @foreach (var item in EligibleItems)
                                    {
                                        <option value="@item.Id">@item.Number - @item.Description (on hand: @item.QuantityOnHand.ToString("N4"))</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="@($"sales-line-quantity-{index}")">Quantity</label>
                                <InputNumber id="@($"sales-line-quantity-{index}")" class="form-control" step="0.0001" @bind-Value="line.Quantity" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="@($"sales-line-price-{index}")">Unit price</label>
                                <InputNumber id="@($"sales-line-price-{index}")" class="form-control" step="0.0001" @bind-Value="line.UnitPrice" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="@($"sales-line-account-{index}")">Revenue account</label>
                                <InputSelect id="@($"sales-line-account-{index}")" class="form-select" @bind-Value="line.SalesAccountId">
                                    <option value="@Guid.Empty">Select Income account</option>
                                    @foreach (var account in EligibleSalesAccounts)
                                    {
                                        <option value="@account.Id">@account.Number - @account.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button class="btn btn-outline-danger" type="button" disabled="@(isSaving || orderInput.Lines.Count == 1)"
                                        aria-label="Remove line" @onclick="() => RemoveOrderLine(line)">Remove</button>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="@($"sales-line-tax-{index}")">Tax code (optional)</label>
                                <InputSelect id="@($"sales-line-tax-{index}")" class="form-select" @bind-Value="line.TaxCodeId">
                                    <option value="">No tax</option>
                                    @foreach (var taxCode in taxCodes)
                                    {
                                        <option value="@taxCode.Id">@taxCode.Code - @taxCode.Description</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    }
                    <button class="btn btn-outline-secondary" type="button" disabled="@isSaving" @onclick="AddOrderLine">Add line</button>
                    <button class="btn btn-primary ms-2" type="submit"
                            disabled="@(isSaving || !EligibleCustomers.Any() || EligibleItems.Count == 0 || EligibleSalesAccounts.Count == 0)">
                        @(isSaving ? "Saving..." : "Create order")
                    </button>
                </fieldset>
            </EditForm>
        </div>
    </section>
    }

    @if (CurrentSection == "fulfillment")
    {
    <section class="sales-workflow-section" aria-labelledby="fulfillment-heading">
        <div class="card-body">
            <h2 id="fulfillment-heading" class="h4">Ship and invoice orders</h2>
            @if (orders.Count == 0)
            {
                <p>Create a sales order to begin the shipment and invoicing workflow.</p>
            }
            else if (periods.Count == 0)
            {
                <div class="alert alert-info" role="status">Create an open, unlocked accounting period before shipment or invoicing.</div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label" for="sales-process-order">Order</label>
                        <InputSelect id="sales-process-order" class="form-select" @bind-Value="selectedOrderId">
                            <option value="@Guid.Empty">Select order</option>
                            @foreach (var order in orders.Where(order => order.Status is SalesOrderStatus.Open or SalesOrderStatus.Shipped))
                            {
                                <option value="@order.Id">@order.OrderNumber - @order.CustomerName (@order.Status)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="sales-posting-period">Accounting period</label>
                        <InputSelect id="sales-posting-period" class="form-select" @bind-Value="postingInput.AccountingPeriodId">
                            <option value="@Guid.Empty">Select period</option>
                            @foreach (var period in periods)
                            {
                                <option value="@period.Id">@period.Name (@period.StartsOn - @period.EndsOn)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="sales-posting-date">Posting date</label>
                        <InputDate id="sales-posting-date" class="form-control" TValue="DateOnly" @bind-Value="postingInput.PostingDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="sales-invoice-number">Invoice number</label>
                        <InputText id="sales-invoice-number" class="form-control" @bind-Value="postingInput.DocumentNumber" />
                    </div>
                </div>
                @if (SelectedOrder is { } selected)
                {
                    <p class="mt-3">
                        <strong>@selected.OrderNumber:</strong> @selected.Description — @selected.CustomerName.
                        Full shipment and invoice quantity: @selected.Lines.Sum(line => line.Quantity).ToString("N4").
                    </p>
                    @if (selected.Status == SalesOrderStatus.Open)
                    {
                        <button class="btn btn-primary" type="button" disabled="@isSaving" @onclick="CreateShipmentDraftAsync">
                            Create shipment journal
                        </button>
                    }
                    else if (selected.Status == SalesOrderStatus.Shipped)
                    {
                        <button class="btn btn-primary" type="button" disabled="@isSaving" @onclick="CreateInvoiceDraftAsync">
                            Create invoice journal
                        </button>
                    }
                }
                <p class="form-text mt-2">Draft journals must be reviewed and posted from General journals. Posting creates the shipment or invoice.</p>
            }
        </div>
    </section>
    }

    @if (CurrentSection == "orders")
    {
    <section class="sales-workflow-section" aria-labelledby="orders-heading">
        <h2 id="orders-heading" class="h4">Sales orders</h2>
        @if (orders.Count == 0)
        {
            <p>No sales orders have been created for this company.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <caption>Sales orders, their lifecycle status, and linked journals</caption>
                    <thead>
                        <tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Date</th><th scope="col">Order lines</th><th scope="col">Status</th><th scope="col">Shipment journal</th><th scope="col">Invoice journal</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <th scope="row">@order.OrderNumber</th>
                                <td>@order.CustomerNumber - @order.CustomerName</td>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                                <td>@string.Join(", ", order.Lines.Select(line => $"{line.ItemNumber}: {line.Quantity:N4} x {line.UnitPrice:N2}"))</td>
                                <td>@order.Status</td>
                                <td>
                                    @if (order.ShipmentJournalBatchId is { } shipmentBatchId)
                                    {
                                        <a href="@($"/financial/journals/{shipmentBatchId}")">Open journal</a>
                                    }
                                </td>
                                <td>
                                    @if (order.InvoiceJournalBatchId is { } invoiceBatchId)
                                    {
                                        <a href="@($"/financial/journals/{invoiceBatchId}")">Open journal</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    }

    @if (CurrentSection == "receivables")
    {
    <section aria-labelledby="receivables-heading">
        <h2 id="receivables-heading" class="h4">Open receivables</h2>
        @if (receivables.Count == 0)
        {
            <p>No posted sales invoices are currently open.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <caption>Posted sales invoices and their outstanding balances</caption>
                    <thead>
                        <tr><th scope="col">Invoice</th><th scope="col">Date</th><th scope="col">Order</th><th scope="col">Customer</th><th scope="col" class="text-end">Net</th><th scope="col" class="text-end">Tax</th><th scope="col" class="text-end">Open amount</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var receivable in receivables)
                        {
                            <tr>
                                <th scope="row">@receivable.InvoiceNumber</th>
                                <td>@receivable.PostingDate.ToString("yyyy-MM-dd")</td>
                                <td>@receivable.OrderNumber</td>
                                <td>@receivable.CustomerNumber - @receivable.CustomerName</td>
                                <td class="text-end">@receivable.NetAmount.ToString("N2")</td>
                                <td class="text-end">@receivable.TaxAmount.ToString("N2")</td>
                                <td class="text-end">@receivable.OpenAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    }
}

@code {
    private IReadOnlyList<SalesCustomerOption> customers = [];
    private IReadOnlyList<SalesItemOption> items = [];
    private IReadOnlyList<SalesAccountOption> accounts = [];
    private IReadOnlyList<AccountingPeriodListItem> periods = [];
    private IReadOnlyList<GeneralJournalTaxCodeOption> taxCodes = [];
    private IReadOnlyList<SalesOrderDetail> orders = [];
    private IReadOnlyList<SalesReceivableDetail> receivables = [];
    private readonly SalesCustomerInput customerInput = new();
    private readonly SalesOrderInput orderInput = new() { Lines = [new SalesOrderLineInput()] };
    private readonly SalesDocumentPostingInput postingInput = new();
    private Guid selectedOrderId;
    private bool isLoading = true;
    private bool isSaving;
    private string? statusMessage;
    private string? errorMessage;
    private string customerSearchTerm = string.Empty;
    private string customerStatusFilter = "all";
    private bool isCustomerStatusMenuOpen;
    private Guid? selectedCustomerId;
    private Guid? pendingDeactivationCustomerId;
    private bool isCustomerSearchExpanded;
    private ElementReference customerSearchInput;

    [Parameter]
    public Guid? CustomerId { get; set; }

    private string CurrentSection => CurrentPath switch
    {
        "/financial/sales/customers/new" => "new-customer",
        _ when CurrentPath.EndsWith("/edit", StringComparison.OrdinalIgnoreCase) => "edit-customer",
        "/financial/sales/create-order" => "create-order",
        "/financial/sales/orders" => "orders",
        "/financial/sales/fulfillment" => "fulfillment",
        "/financial/sales/receivables" => "receivables",
        _ => "customers"
    };
    private string CurrentPath => ("/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0])
        .ToLowerInvariant();
    private string CurrentSectionTitle => CurrentSection switch
    {
        "customers" => "Customers",
        "new-customer" => "New customer",
        "edit-customer" => "Edit customer",
        "create-order" => "Create sales order",
        "orders" => "Sales orders",
        "fulfillment" => "Ship and invoice orders",
        "receivables" => "Open receivables",
        _ => "Sales"
    };

    private string CustomerStatusFilterLabel => CustomerStatusFilterOptions
        .Single(option => option.Value == customerStatusFilter).Label;
    private static readonly (string Value, string Label)[] CustomerStatusFilterOptions =
    [
        ("all", "All"),
        ("active", "Active"),
        ("blocked", "Blocked"),
        ("inactive", "Inactive")
    ];

    private IEnumerable<SalesCustomerOption> EligibleCustomers =>
        customers.Where(customer => !customer.IsBlocked && !customer.IsInactive);
    private IEnumerable<SalesCustomerOption> FilteredCustomers => customers.Where(customer =>
        (customerStatusFilter switch
        {
            "active" => !customer.IsInactive && !customer.IsBlocked,
            "blocked" => !customer.IsInactive && customer.IsBlocked,
            "inactive" => customer.IsInactive,
            _ => !customer.IsInactive
        }) &&
        (string.IsNullOrWhiteSpace(customerSearchTerm) ||
         customer.Number.Contains(customerSearchTerm, StringComparison.OrdinalIgnoreCase) ||
         customer.Name.Contains(customerSearchTerm, StringComparison.OrdinalIgnoreCase)));
    private SalesCustomerOption? SelectedCustomer => FilteredCustomers
        .SingleOrDefault(customer => customer.Id == selectedCustomerId);
    private SalesCustomerOption? PendingDeactivationCustomer => customers
        .SingleOrDefault(customer => customer.Id == pendingDeactivationCustomerId);
    private IReadOnlyList<SalesItemOption> EligibleItems => items.Where(item => !item.IsBlocked).ToArray();
    private IReadOnlyList<SalesAccountOption> EligibleSalesAccounts => accounts
        .Where(account => account.Category == AccountCategory.Income &&
                          !account.IsBlocked)
        .ToArray();
    private IReadOnlyList<SalesAccountOption> EligibleReceivablesAccounts => accounts
        .Where(account => account.Category == AccountCategory.Asset &&
                          !account.IsBlocked)
        .ToArray();
    private SalesOrderDetail? SelectedOrder => orders.SingleOrDefault(order => order.Id == selectedOrderId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
            if (CurrentSection == "edit-customer" && CustomerId is { } customerId)
            {
                var customer = customers.SingleOrDefault(candidate => candidate.Id == customerId);
                if (customer is null)
                {
                    errorMessage = "The customer is not available in the active company.";
                }
                else
                {
                    customerInput.Number = customer.Number;
                    customerInput.Name = customer.Name;
                    customerInput.ReceivablesAccountId = customer.ReceivablesAccountId;
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var loadedCustomers = await SalesService.GetCustomersAsync(user);
        var loadedItems = await SalesService.GetItemsAsync(user);
        var loadedAccounts = await SalesService.GetSalesAccountsAsync(user);
        var loadedPeriods = await SalesService.GetOpenPeriodsAsync(user);
        var loadedTaxCodes = await SalesService.GetTaxCodesAsync(user);
        var loadedOrders = await SalesService.GetOrdersAsync(user);
        var loadedReceivables = await SalesService.GetOpenReceivablesAsync(user);
        customers = loadedCustomers;
        items = loadedItems;
        accounts = loadedAccounts;
        periods = loadedPeriods;
        taxCodes = loadedTaxCodes;
        orders = loadedOrders;
        receivables = loadedReceivables;
        if (postingInput.AccountingPeriodId == Guid.Empty && periods.Count > 0)
        {
            postingInput.AccountingPeriodId = periods[0].Id;
        }
        if (selectedOrderId == Guid.Empty || orders.All(order => order.Id != selectedOrderId))
        {
            selectedOrderId = orders.FirstOrDefault(order =>
                order.Status is SalesOrderStatus.Open or SalesOrderStatus.Shipped)?.Id ?? Guid.Empty;
        }
    }

    private async Task CreateCustomerAsync()
    {
        await ExecuteAsync(async user =>
        {
            await SalesService.CreateCustomerAsync(user, customerInput);
            customerInput.Number = string.Empty;
            customerInput.Name = string.Empty;
            customerInput.ReceivablesAccountId = Guid.Empty;
            statusMessage = "Customer created.";
            Navigation.NavigateTo("/financial/sales/customers");
        });
    }

    private async Task UpdateCustomerAsync()
    {
        if (CustomerId is not { } customerId)
        {
            errorMessage = "The customer to edit is not available.";
            return;
        }

        await ExecuteAsync(async user =>
        {
            await SalesService.UpdateCustomerAsync(user, customerId, customerInput);
            statusMessage = "Customer updated.";
            Navigation.NavigateTo("/financial/sales/customers");
        });
    }

    private void SelectCustomer(Guid customerId)
    {
        selectedCustomerId = selectedCustomerId == customerId ? null : customerId;
        pendingDeactivationCustomerId = null;
    }

    private void ClearCustomerSelection()
    {
        selectedCustomerId = null;
        pendingDeactivationCustomerId = null;
    }

    private void ToggleCustomerStatusMenu()
    {
        isCustomerStatusMenuOpen = !isCustomerStatusMenuOpen;
    }

    private void CloseCustomerStatusMenu()
    {
        isCustomerStatusMenuOpen = false;
    }

    private void SetCustomerStatusFilter(string filter)
    {
        customerStatusFilter = filter;
        isCustomerStatusMenuOpen = false;
        ClearCustomerSelection();
    }

    private Task HandleCustomerStatusKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseCustomerStatusMenu();
        }

        return Task.CompletedTask;
    }

    private async Task ToggleCustomerSearch()
    {
        isCustomerSearchExpanded = !isCustomerSearchExpanded;
        if (isCustomerSearchExpanded)
        {
            await InvokeAsync(StateHasChanged);
            await customerSearchInput.FocusAsync();
            return;
        }

        customerSearchTerm = string.Empty;
        ClearCustomerSelection();
    }

    private Task HandleCustomerSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && isCustomerSearchExpanded)
        {
            return ToggleCustomerSearch();
        }

        return Task.CompletedTask;
    }

    private void EditSelectedCustomer()
    {
        if (SelectedCustomer is { } customer)
        {
            Navigation.NavigateTo($"/financial/sales/customers/{customer.Id}/edit");
        }
    }

    private void RequestCustomerDeactivation()
    {
        if (SelectedCustomer is { IsInactive: false } customer)
        {
            pendingDeactivationCustomerId = customer.Id;
        }
    }

    private void CancelCustomerDeactivation() => pendingDeactivationCustomerId = null;

    private async Task DeactivateCustomerAsync()
    {
        if (PendingDeactivationCustomer is not { IsInactive: false } customer)
        {
            return;
        }

        await ExecuteAsync(async user =>
        {
            await SalesService.SetCustomerInactiveAsync(user, customer.Id, true);
            selectedCustomerId = null;
            pendingDeactivationCustomerId = null;
            statusMessage = "Customer marked inactive.";
        });
    }

    private async Task ReactivateSelectedCustomerAsync()
    {
        if (SelectedCustomer is not { IsInactive: true } customer)
        {
            return;
        }

        await ExecuteAsync(async user =>
        {
            await SalesService.SetCustomerInactiveAsync(user, customer.Id, false);
            selectedCustomerId = null;
            customerStatusFilter = "all";
            statusMessage = "Customer reactivated.";
        });
    }

    private static string CustomerStatus(SalesCustomerOption customer) =>
        customer.IsInactive ? "Inactive" : customer.IsBlocked ? "Blocked" : "Active";

    private void AddOrderLine() => orderInput.Lines.Add(new SalesOrderLineInput());

    private void RemoveOrderLine(SalesOrderLineInput line)
    {
        if (orderInput.Lines.Count > 1)
        {
            orderInput.Lines.Remove(line);
        }
    }

    private async Task CreateOrderAsync()
    {
        await ExecuteAsync(async user =>
        {
            var orderId = await SalesService.CreateOrderAsync(user, orderInput);
            orderInput.OrderNumber = string.Empty;
            orderInput.Description = string.Empty;
            orderInput.CustomerId = Guid.Empty;
            orderInput.OrderDate = DateOnly.FromDateTime(DateTime.Today);
            orderInput.Lines = [new SalesOrderLineInput()];
            selectedOrderId = orderId;
            statusMessage = "Sales order created.";
        });
    }

    private async Task CreateShipmentDraftAsync()
    {
        if (SelectedOrder is not { } order)
        {
            return;
        }

        await CreateDocumentDraftAsync(
            order,
            (user, orderId) => SalesService.CreateShipmentDraftAsync(user, orderId, postingInput),
            "Shipment journal draft created. Review and post the journal to reduce inventory and recognize cost of goods sold.");
    }

    private async Task CreateInvoiceDraftAsync()
    {
        if (SelectedOrder is not { } order)
        {
            return;
        }

        await CreateDocumentDraftAsync(
            order,
            (user, orderId) => SalesService.CreateInvoiceDraftAsync(user, orderId, postingInput),
            "Invoice journal draft created. Review and post the journal to recognize revenue, tax, and receivables.");
    }

    private async Task CreateDocumentDraftAsync(
        SalesOrderDetail order,
        Func<System.Security.Claims.ClaimsPrincipal, Guid, Task<Guid>> createDraft,
        string successMessage)
    {
        await ExecuteAsync(async user =>
        {
            var batchId = await createDraft(user, order.Id);
            statusMessage = successMessage;
            Navigation.NavigateTo($"/financial/journals/{batchId}");
        });
    }

    private async Task ExecuteAsync(Func<System.Security.Claims.ClaimsPrincipal, Task> action)
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            await action(user);
            await LoadAsync();
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
