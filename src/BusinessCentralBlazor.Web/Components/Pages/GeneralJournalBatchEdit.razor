@page "/financial/journals/{BatchId:guid}/edit"
@attribute [Authorize(Policy = CompanyAuthorizationPolicies.ActiveCompany)]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGeneralJournalService GeneralJournalService
@inject NavigationManager Navigation

<PageTitle>Edit journal batch</PageTitle>
<h1>Edit journal batch</h1>

@if (isLoading)
{
    <p role="status" aria-live="polite">Loading journal batch...</p>
}
else if (companyContextUnavailable)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
    <a href="/account/company" data-enhance-nav="false">Select an active company</a>
}
else if (batch is null || batch.Status != JournalBatchStatus.Open)
{
    <div class="alert alert-danger" role="alert">An editable journal batch was not found in the active company.</div>
    <a href="/financial/journals">Back to journals</a>
}
else if (openPeriods.Count == 0)
{
    <div class="alert alert-info" role="status">
        An open, unlocked accounting period is required.
        <a href="/financial/accounting-periods">Manage accounting periods</a>
    </div>
}
else
{
    <EditForm Model="@input" OnValidSubmit="SaveAsync" FormName="edit-general-journal-batch">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        <fieldset disabled="@isSaving">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="batch-name">Batch name</label>
                    <InputText id="batch-name" class="form-control" maxlength="32" @bind-Value="input.Name" />
                    <ValidationMessage For="@(() => input.Name)" />
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="batch-description">Description</label>
                    <InputText id="batch-description" class="form-control" maxlength="100"
                               @bind-Value="input.Description" />
                    <ValidationMessage For="@(() => input.Description)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="batch-period">Default accounting period</label>
                    <InputSelect id="batch-period" class="form-select" @bind-Value="input.DefaultAccountingPeriodId">
                        @foreach (var period in openPeriods)
                        {
                            <option value="@period.Id">@period.Name</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </fieldset>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save batch")
            </button>
            <a class="btn btn-outline-secondary" href="@($"/financial/journals/{BatchId}")">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid BatchId { get; set; }

    private readonly GeneralJournalBatchInput input = new();
    private GeneralJournalBatchDetail? batch;
    private IReadOnlyList<AccountingPeriodListItem> openPeriods = [];
    private bool isLoading = true;
    private bool isSaving;
    private bool companyContextUnavailable;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            batch = await GeneralJournalService.GetBatchAsync(user, BatchId);
            openPeriods = (await GeneralJournalService.GetPeriodsAsync(user))
                .Where(period => !period.IsClosed && !period.DateLocked)
                .ToArray();
            if (batch is not null)
            {
                input.Name = batch.Name;
                input.Description = batch.Description;
                input.DefaultAccountingPeriodId = batch.DefaultAccountingPeriodId;
                if (!openPeriods.Any(period => period.Id == input.DefaultAccountingPeriodId))
                {
                    input.DefaultAccountingPeriodId = openPeriods.FirstOrDefault()?.Id ?? Guid.Empty;
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (await GeneralJournalService.UpdateBatchAsync(user, BatchId, input))
            {
                Navigation.NavigateTo($"/financial/journals/{BatchId}");
            }
            else
            {
                errorMessage = "The journal batch no longer exists in the active company.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            companyContextUnavailable = true;
            errorMessage = "Your active company is no longer available. Select an active company and try again.";
        }
        catch (ValidationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
